  "cards": [
    {
      "dot": "cyan",
      "title": "Collect",
      "items": [
        "Framing drafts whatever hypotheses and kill criteria the contract lacks, before any search",
        "Sweeps search, pick, fetch and extract; gap analysis adds waves",
        "Ranking keeps T1-T3 claims round-robin across sub-questions, importance first, up to the budget"
      ]
    },
    {
      "dot": "rose",
      "title": "Verify",
      "items": [
        "Three different lenses: two refutations kill; fewer than two answers leave a claim unverified",
        "At standard depth and up, a blind re-fetch audits every panel-voted claim, killed ones included",
        "A partial survivor: a supported restatement replaces it, a failing one is demoted, none usable keeps it flagged"
      ]
    },
    {
      "dot": "amber",
      "title": "Every exit reports",
      "items": [
        "Every exit after planning returns a report saying why it stopped; a rejected credential exits 2",
        "Limits ride all of them; panel instruments ride every exit after the panel",
        "Quick depth has no rescue, so an all-refuted quick run exits straight from the panel"
      ]
    }
  ]
