# 2026-09-27 (moved to ~/deepresearch-reports/scratch-2026-09-25). They belong
# there, never in a commit. out/*.md at the top level stays tracked on purpose.
/page*.txt
/page-*.html
/extract-*
/out-*/
/out/*/
